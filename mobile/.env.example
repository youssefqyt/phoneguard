# PhoneGuard mobile — environment template
#
# Copy to `.env` and adjust. The browser build uses VITE_API_URL and defaults
# to http://localhost:3000/api/v1. The native app uses its platform default
# unless API_URL is explicitly injected during its build.
#
# Plain React Native does not load .env files by itself. Android APK builds can
# embed PHONEGUARD_API_URL via scripts/configure-api-url.js.

# Base URL of the NestJS API, including the /api/v1 prefix.
VITE_API_URL=http://localhost:3000/api/v1

# Optional non-web build override. The Android emulator default remains
# http://10.0.2.2:3000/api/v1 when no URL is injected.
# API_URL=http://localhost:3000/api/v1
